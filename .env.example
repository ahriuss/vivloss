# ── Flask ──
FLASK_SECRET=change-me-to-random-string
PORT=5002
# DATABASE_URL=  # leave empty — uses absolute path instance/vivlos.db automatically

# ── AI engines (достаточно одного) ──
# Google Gemini (рекомендуется, бесплатный tier)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (быстрый, бесплатный)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── STT / TTS (опционально) ──
# Whisper: base / small / medium
WHISPER_MODEL=base

# Vosk offline models (пути к уже скачанным моделям)
VOSK_RU_MODEL_PATH=ml_models/vosk-ru
VOSK_KZ_MODEL_PATH=ml_models/vosk-kk
VOSK_EN_MODEL_PATH=ml_models/vosk-en
VOSK_DE_MODEL_PATH=ml_models/vosk-de
